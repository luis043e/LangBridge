{
    "compilerOptions":  {
                            "module":  "NodeNext",
                            "moduleResolution":  "NodeNext",
                            "target":  "ES2022",
                            "lib":  [
                                        "ES2022"
                                    ],
                            "outDir":  "lib",
                            "rootDir":  "src",
                            "strict":  true,
                            "noImplicitReturns":  true,
                            "noUnusedLocals":  true,
                            "noUnusedParameters":  true,
                            "sourceMap":  true,
                            "esModuleInterop":  true,
                            "forceConsistentCasingInFileNames":  true,
                            "skipLibCheck":  true
                        },
    "compileOnSave":  false,
    "include":  [
                    "src"
                ]
}
