rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function connectionRequest(connectionId) {
      return get(
        /databases/$(database)/documents/connectionRequests/$(connectionId)
      );
    }

    function isAcceptedConnection(connectionId) {
      return connectionRequest(connectionId).data.status == 'accepted';
    }

    function isConnectionParticipant(connectionId) {
      return request.auth.uid ==
          connectionRequest(connectionId).data.senderId
        || request.auth.uid ==
          connectionRequest(connectionId).data.recipientId;
    }

    function isConversationParticipant(conversationId) {
      return request.auth.uid in
        get(
          /databases/$(database)/documents/conversations/$(conversationId)
        ).data.participants;
    }
  function hasLegalAcceptance(data) {
 return data.keys().hasAll([
 'legalAcceptedAt',
 'termsVersion',
 'privacyVersion',
 'communityGuidelinesVersion',
 'legalAcceptanceLanguage',
 'legalAcceptanceMethod'
 ]);
 }

function hasAnyLegalAcceptance(data) {
 return data.keys().hasAny([
 'legalAcceptedAt',
 'termsVersion',
 'privacyVersion',
 'communityGuidelinesVersion',
 'legalAcceptanceLanguage',
 'legalAcceptanceMethod'
 ]);
 }

function isValidLegalAcceptance(data) {
 return hasLegalAcceptance(data)
 && data.legalAcceptedAt == request.time
 && data.termsVersion == '0.1'
 && data.privacyVersion == '0.1'
 && data.communityGuidelinesVersion == '0.1'
 && data.legalAcceptanceLanguage in [
 'en',
 'es',
 'fr',
 'pt',
 'de',
 'it',
 'ja',
 'ko',
 'zh',
 'ar',
 'ru',
 'tr',
 'hi',
 'bn',
 'nl',
 'pl'
 ]
 && data.legalAcceptanceMethod in [
 'email',
 'google'
 ];
 }

function hasValidOrNoLegalAcceptance(data) {
 return !hasAnyLegalAcceptance(data)
 || isValidLegalAcceptance(data);
 }

function keepsLegalAcceptanceImmutable() {
 return (
 !hasAnyLegalAcceptance(resource.data)
 && hasValidOrNoLegalAcceptance(
 request.resource.data
 )
 )
 || (
 hasLegalAcceptance(resource.data)
 && hasLegalAcceptance(
 request.resource.data
 )
 && request.resource.data.legalAcceptedAt
 == resource.data.legalAcceptedAt
 && request.resource.data.termsVersion
 == resource.data.termsVersion
 && request.resource.data.privacyVersion
 == resource.data.privacyVersion
 && request.resource.data.communityGuidelinesVersion
 == resource.data.communityGuidelinesVersion
 && request.resource.data.legalAcceptanceLanguage
 == resource.data.legalAcceptanceLanguage
 && request.resource.data.legalAcceptanceMethod
 == resource.data.legalAcceptanceMethod
 );
 }
    match /users/{userId} {
  allow read: if isAuthenticated();

  allow create: if isAuthenticated()
    && request.auth.uid == userId
    && request.resource.data.keys().hasOnly([
      'uid',
      'fullName',
      'email',
      'photoURL',
      'googlePhotoURL',
      'authProvider',
      'countryCode',
      'countryName',
      'city',
      'bio',
      'interfaceLanguage',
      'nativeLanguage',
      'learningLanguage',
      'level',
      'profileCompleted',
      'online',
      'accountCreatedAt',
      'blockedUserIds',
      'isProfileVisible',
      'deletionRequested',
      'deletionRequestedAt',
      'legalAcceptedAt',
      'termsVersion',
      'privacyVersion',
      'communityGuidelinesVersion',
      'legalAcceptanceLanguage',
      'legalAcceptanceMethod',
      'createdAt',
      'updatedAt'
    ])
    && (
 !request.resource.data.keys().hasAny(['uid'])
 || request.resource.data.uid == userId
 )
 && hasValidOrNoLegalAcceptance(
 request.resource.data
 );

  allow update: if isAuthenticated()
    && request.auth.uid == userId
    && request.resource.data.keys().hasOnly([
      'uid',
      'fullName',
      'email',
      'photoURL',
      'googlePhotoURL',
      'authProvider',
      'countryCode',
      'countryName',
      'city',
      'bio',
      'interfaceLanguage',
      'nativeLanguage',
      'learningLanguage',
      'level',
      'profileCompleted',
      'online',
      'accountCreatedAt',
      'blockedUserIds',
      'isProfileVisible',
      'deletionRequested',
      'deletionRequestedAt',
      'legalAcceptedAt',
      'termsVersion',
      'privacyVersion',
      'communityGuidelinesVersion',
      'legalAcceptanceLanguage',
      'legalAcceptanceMethod',
      'createdAt',
      'updatedAt'
    ])
    && (
      !request.resource.data.keys().hasAny(['uid'])
      || request.resource.data.uid == userId
    )
    && (
 !resource.data.keys().hasAny(['uid'])
 || request.resource.data.uid == resource.data.uid
 )
 && keepsLegalAcceptanceImmutable();

  allow delete: if false;
}

match /connectionRequests/{requestId} {
  allow create: if isAuthenticated()
    && request.resource.data.keys().hasOnly([
      'senderId',
      'recipientId',
      'senderName',
      'recipientName',
      'status',
      'createdAt',
      'updatedAt'
    ])
    && request.resource.data.senderId
      == request.auth.uid
    && request.resource.data.recipientId
      is string
    && request.resource.data.recipientId
      != request.auth.uid
    && request.resource.data.senderName
      is string
    && request.resource.data.senderName.size() > 0
    && request.resource.data.senderName.size() <= 100
    && request.resource.data.recipientName
      is string
    && request.resource.data.recipientName.size() > 0
    && request.resource.data.recipientName.size() <= 100
    && request.resource.data.status
      == 'pending'
    && request.resource.data.createdAt
      == request.time
    && request.resource.data.updatedAt
      == request.time
    && requestId
      == request.resource.data.senderId
        + '_'
        + request.resource.data.recipientId;

  allow read: if isAuthenticated()
    && (
      request.auth.uid
        == resource.data.senderId
      || request.auth.uid
        == resource.data.recipientId
    );

  allow update: if isAuthenticated()
    && request.auth.uid
      == resource.data.recipientId
    && resource.data.status
      == 'pending'
    && request.resource.data.status in [
      'accepted',
      'rejected'
    ]
    && request.resource.data.diff(resource.data)
      .affectedKeys()
      .hasOnly([
        'status',
        'updatedAt'
      ])
    && request.resource.data.updatedAt
      == request.time;

  allow delete: if false;
}
    match /conversations/{conversationId} {
allow create: if isAuthenticated()
  && isAcceptedConnection(conversationId)
  && isConnectionParticipant(conversationId)
  && request.resource.data.keys().hasOnly([
    'connectionId',
    'participants',
    'createdAt',
    'updatedAt'
  ])
  && request.resource.data.connectionId
    == conversationId
  && request.resource.data.participants is list
  && request.resource.data.participants.size() == 2
  && request.resource.data.participants.hasAll([
    connectionRequest(conversationId).data.senderId,
    connectionRequest(conversationId).data.recipientId
  ])
  && request.resource.data.createdAt
    == request.time
  && request.resource.data.updatedAt
    == request.time;

allow get: if isAuthenticated()
  && isAcceptedConnection(conversationId)
  && isConnectionParticipant(conversationId);

allow list: if isAuthenticated()
  && request.auth.uid in resource.data.participants;

allow update, delete: if false;

      match /messages/{messageId} {
  allow read: if isAuthenticated()
    && isConversationParticipant(conversationId);

  allow create: if isAuthenticated()
    && isConversationParticipant(conversationId)
    && request.resource.data.keys().hasOnly([
      'senderId',
      'text',
      'createdAt',
      'readAt'
    ])
    && request.resource.data.senderId
      == request.auth.uid
    && request.resource.data.text
      is string
    && request.resource.data.text.size() > 0
    && request.resource.data.text.size() <= 1000
    && request.resource.data.createdAt
      == request.time
    && request.resource.data.readAt
      == null;

  allow update: if isAuthenticated()
    && isConversationParticipant(conversationId)
    && resource.data.senderId
      != request.auth.uid
    && resource.data.readAt
      == null
    && request.resource.data.diff(resource.data)
      .affectedKeys()
      .hasOnly([
        'readAt'
      ])
    && request.resource.data.readAt
      == request.time;

  allow delete: if false;
}
    }

    match /reports/{reportId} {
      allow create: if isAuthenticated()
        && request.resource.data.reporterId
          == request.auth.uid
        && request.resource.data.reporterEmail
          is string
        && request.resource.data.category
          in [
            'technical',
            'account',
            'user',
            'privacy',
            'other'
          ]
        && request.resource.data.description
          is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 1000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt
          == request.time
        && request.resource.data.updatedAt
          == request.time
        && request.resource.data.keys().hasOnly([
          'reporterId',
          'reporterEmail',
          'category',
          'description',
          'status',
          'createdAt',
          'updatedAt'
        ]);

      allow read, update, delete: if false;
    }

    match /accountDeletionRequests/{requestId} {
      allow create: if isAuthenticated()
        && request.resource.data.userId
          == request.auth.uid
        && request.resource.data.userEmail
          is string
        && request.resource.data.status
          == 'pending'
        && request.resource.data.createdAt
          == request.time
        && request.resource.data.updatedAt
          == request.time
        && request.resource.data.keys().hasOnly([
          'userId',
          'userEmail',
          'status',
          'createdAt',
          'updatedAt'
        ]);

      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
