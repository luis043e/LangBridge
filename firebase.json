{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "functions": [
    {
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "source": "functions",
      "codebase": "default"
    }
  ],
  "emulators": {
    "logging": {
      "host": "0.0.0.0",
      "port": 4500
    },
    "functions": {
      "host": "0.0.0.0",
      "port": 5001
    },
    "singleProjectMode": true,
    "firestore": {
      "host": "0.0.0.0",
      "port": 8080
    },
    "hub": {
      "host": "0.0.0.0",
      "port": 4400
    },
    "auth": {
      "host": "0.0.0.0",
      "port": 9099
    },
    "ui": {
      "host": "0.0.0.0",
      "port": 4000,
      "enabled": true
    }
  }
}
