{
  "expo": {
    "name": "LangBridge",
    "slug": "LangBridge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/langbridge-logo.png",
    "scheme": "langbridge",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.luis043e.langbridge",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
  "backgroundColor": "#050B24",
  "foregroundImage": "./assets/images/langbridge-logo.png"
},
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin",
      [
  "expo-splash-screen",
  {
    "backgroundColor": "#050B24",
    "image": "./assets/images/langbridge-logo.png",
    "imageWidth": 200
  }
],
            "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4aa31858-9ba7-4fdd-8a9c-ec6b03aa4d9a"
      }
    },
    "owner": "langbridge"
  }
}
